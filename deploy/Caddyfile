# Greed Island — Caddy reverse proxy configuration.
#
# v1 access policy: Tailscale-internal only. The compose file binds
# Caddy to the host's Tailscale interface so this Caddyfile is reached
# only by Tailnet clients. The site block below uses Caddy's internal
# CA so we can serve TLS to the Tailnet without Let's Encrypt's public
# DNS-01 / HTTP-01 challenge requirements.
#
# When the platform graduates to public exposure (separate change),
# replace `tls internal` with the production ACME configuration and
# satisfy the deployment hardening gate first.

{
	# Local CA for Tailscale-internal TLS. Caddy auto-generates and
	# auto-trusts this in container; clients install the CA cert if
	# they want green padlocks.
	auto_https disable_redirects
	# Reasonable defaults for a small reverse proxy.
	servers {
		trusted_proxies static private_ranges
	}
}

{$DOMAIN} {
	# Tailscale-internal TLS via Caddy's internal CA.
	tls internal

	# Static frontend assets served directly from the shared volume.
	root * /srv/greed-island-web
	encode zstd gzip

	# API + SSE: any path under /api goes to the Node.js server.
	handle /api/* {
		reverse_proxy server:3000 {
			# SSE pass-through — disable proxy buffering on the
			# /api/events/stream route so committed events reach
			# the client within the same wall-clock second.
			flush_interval -1
			# Long-lived connections for SSE.
			transport http {
				read_timeout 24h
				write_timeout 24h
				dial_timeout 5s
			}
		}
	}

	# SPA fallback: any non-API route serves index.html so React Router
	# can take over client-side navigation.
	handle {
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

# Optional internal-only http alias for hosts that resolve the bare name.
http://hunter.sisihome:80 {
	reverse_proxy server:3000
}
