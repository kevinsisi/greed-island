# CANDIDATE ONLY. Source publication does not authorize a live cutover.
# Exact HTTPS browser Origin; preserves the current private Tailnet-facing URL.
GREED_ISLAND_ALLOWED_ORIGINS=https://greed.sisihome.org

# REQUIRED owner decision. Select an EXISTING volume containing the reviewed,
# backed-up unified canonical greed-island.sqlite. No default/new volume.
# Leave unset until exact identity, admin and progress import gates pass.
GREED_L390_CANONICAL_VOLUME=

# Existing loopback web entry. Backend 4179 remains container-internal.
GREED_L390_HOST_PORT=28100

# Local source builds may leave these blank. CI/CD supplies exact full SHA
# image tags and matching health metadata; prior images are never overwritten.
GREED_L390_IMAGE_TAG=local
GREED_L390_BUILD_SHA=

# Optional immutable trusted OpenCode HTTP(S) origin, without path/credentials.
# Blank/invalid means no global Basic credential forwarding. Editable provider
# URLs never establish trust. Set only after verifying the intended origin.
OPENCODE_CREDENTIAL_ORIGIN=
