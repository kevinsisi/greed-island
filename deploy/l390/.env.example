# Browser Origin allowed to call the isolated multiplayer API.
MULTIPLAYER_ALLOWED_ORIGINS=https://greed.sisihome.org

# L390 tailnet IP; binds only to tailnet, never 0.0.0.0 or LAN.
GREED_L390_BIND_ADDR=100.79.199.43

# Web entry port; this does not expose multiplayer port 4179.
GREED_L390_HOST_PORT=28100
