# Copy to deploy/.env and fill in. Do NOT commit deploy/.env.
# All variables here are consumed by deploy/docker-compose.yml.

# ── Networking ────────────────────────────────────────────────────────
# Bind Caddy to the desktop host's Tailscale interface address so the
# site is reachable only from the Tailnet. Find it via `tailscale ip -4`.
# Example: 100.83.112.20
TAILSCALE_BIND_ADDR=

# Domain that resolves (via Tailscale MagicDNS or split-horizon DNS)
# to TAILSCALE_BIND_ADDR. Default matches the project plan.
DOMAIN=hunter.sisihome.org

# ── Auth ──────────────────────────────────────────────────────────────
# Required. Use `openssl rand -hex 64` to generate. Rotating this
# invalidates all sessions.
JWT_SECRET=
# bcrypt cost factor. 12 is a sensible 2026 default; raise to 14 for
# stronger machines if registration/login latency stays acceptable.
BCRYPT_COST=12

# ── AI ────────────────────────────────────────────────────────────────
# Default model used by the narration runtime. Override per
# key-pool-standard if needed.
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated provider keys. Both env-loaded and DB-loaded keys
# are merged at boot; placeholder strings (YOUR_KEY_HERE, xxx) are
# filtered out by the import path.
GEMINI_API_KEYS=
OPENAI_API_KEYS=
