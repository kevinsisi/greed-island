# Copy to deploy/.env and fill in. Do NOT commit deploy/.env.
# All variables here are consumed by deploy/docker-compose.yml.

# ── Networking ────────────────────────────────────────────────────────
# Bind the web container's host port to the desktop's Tailscale
# interface so the service is reachable only from Tailnet members.
# Find the Tailscale IP via `tailscale ip -4` (e.g. 100.83.112.20).
TAILSCALE_BIND_ADDR=

# Host port that the RPi Caddy reverse-proxies to. Pick something
# unused on the desktop — the URL Routing Table in CLAUDE.md tracks
# port allocations across HomeProject services.
HOST_PORT=7100

# ── Auth ──────────────────────────────────────────────────────────────
# Required. Use `openssl rand -hex 64` to generate. Rotating this
# invalidates all sessions.
JWT_SECRET=
# bcrypt cost factor. 12 is a sensible 2026 default; raise to 14 for
# stronger machines if registration/login latency stays acceptable.
BCRYPT_COST=12

# Comma-separated admin email allow-list. Accounts on this list can
# manage the Gemini API key pool via /settings. If empty, the first
# registered account is treated as admin (good default for a fresh
# deploy with a single operator).
GREED_ISLAND_ADMIN_EMAILS=

# ── AI ────────────────────────────────────────────────────────────────
# Default model used by the AI NPC dialog. Override per
# key-pool-standard if needed.
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated Gemini API keys. Both names are accepted; entries
# from both are merged into the SQLite key pool at boot. Admin can
# also add/remove keys at runtime via the /settings page. Placeholder
# strings (YOUR_KEY_HERE, xxx) are filtered out automatically.
GEMINI_API_KEY=
GEMINI_API_KEYS=
OPENAI_API_KEYS=
